<article class="card-evento"><% if (evento.imagem) { %><img class="imagem-card-evento" src="<%= evento.imagem %>" alt="Imagem de <%= evento.nome %>"><% } %><div class="conteudo-evento"><span class="categoria"><%= evento.categoria %></span><% if (evento.privado) { %><span class="selo-destaque">🔒 Privado</span><% } %><h2><%= evento.nome %></h2><p><%= evento.descricao %></p><div class="metadados"><span>📅 <%= evento.data %></span><% if (evento.horario_inicio && evento.horario_fim) { %><span>🕒 <%= evento.horario_inicio %> – <%= evento.horario_fim %></span><% } %><span>📍 <%= evento.local %></span></div><% if (evento.destaque && evento.imagem && !evento.privado) { %><span class="selo-destaque">★ Em destaque</span><% } %><a class="botao botao-largo" href="/eventos/<%= evento.id %>">Ver evento e comentários</a></div></article>