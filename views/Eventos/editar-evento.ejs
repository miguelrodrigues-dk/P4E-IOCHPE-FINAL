<%- include('../partials/header', { titulo: 'Editar evento | P4E' }) %>

<main class="container pagina-detalhes">
  <a class="link-voltar" href="/eventos/<%= evento.id %>">← Voltar aos detalhes</a>

  <section class="form-comentario form-novo-evento">
    <h1>Editar evento</h1>
    <p class="descricao-formulario">
      Atualize as informações abaixo para modificar os dados do evento no P4E.
    </p>

    <form action="/eventos/<%= evento.id %>/editar" method="POST">

      <label for="nome">Nome do evento</label>
      <input
        id="nome"
        name="nome"
        type="text"
        maxlength="100"
        value="<%= evento.nome %>"
        required
      >

      <label for="categoria">Categoria</label>
      <select id="categoria" name="categoria" required>
        <option value="">Selecione uma categoria</option>
        <% ['Música', 'Social', 'Cultura', 'Tecnologia', 'Esportes', 'Educação', 'Outro'].forEach(cat => { %>
          <option value="<%= cat %>" <%= evento.categoria === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>

      <label for="data">Data do evento</label>
      <input
        id="data"
        name="data"
        type="text"
        placeholder="DD/MM/AAAA"
        pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}"
        title="Informe a data no formato DD/MM/AAAA"
        value="<%= evento.data %>"
        required
      >

      <div class="horarios-evento">
        <div><label for="horario_inicio">Horário de início</label><input id="horario_inicio" name="horario_inicio" type="time" value="<%= evento.horario_inicio || '' %>" required></div>
        <div><label for="horario_fim">Horário de término</label><input id="horario_fim" name="horario_fim" type="time" value="<%= evento.horario_fim || '' %>" required></div>
      </div>

      <label for="local">Local</label>
      <input
        id="local"
        name="local"
        type="text"
        maxlength="150"
        value="<%= evento.local %>"
        required
      >

      <label for="descricao">Descrição</label>
      <textarea
        id="descricao"
        name="descricao"
        rows="5"
        maxlength="1500"
        required
      ><%= evento.descricao %></textarea>

      <!-- VISIBILIDADE: PÚBLICO OU PRIVADO -->
      <div class="opcao-destaque">
        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Visibilidade do evento</label>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <label style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; cursor: pointer;">
            <input type="radio" name="visibilidade" value="publico" <%= !evento.privado ? 'checked' : '' %>>
            <span>🌐 Público</span>
          </label>

          <label style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; cursor: pointer;">
            <input type="radio" name="visibilidade" value="privado" <%= evento.privado ? 'checked' : '' %>>
            <span>🔒 Privado</span>
          </label>
        </div>

        <p id="texto-ajuda-visibilidade" style="margin-top: 8px; font-size: 0.9rem; opacity: 0.85;"></p>
      </div>

      <div id="campo-imagem">
        <label for="imagemArquivo" id="label-imagem">Imagem de capa (opcional)</label>
        <input id="imagemArquivo" type="file" accept="image/png,image/jpeg,image/webp,image/gif">
        <input id="imagemUpload" name="imagemUpload" type="hidden">
        <p class="ajuda-imagem">Escolha uma imagem salva no computador (até 4 MB). Ela será usada na capa e no carrossel.</p>
       <% if (evento.imagem) { %>
  <img
    id="previewImagemEvento"
    class="preview-imagem-evento"
    src="<%= evento.imagem %>"
    alt="Imagem atual do evento"
  >
<% } else { %>
  <img
    id="previewImagemEvento"
    class="preview-imagem-evento"
    alt="Prévia da imagem"
    hidden
  >
<% } %>
      </div>

      <div class="opcao-destaque" id="bloco-destaque">
        <label class="checkbox-destaque" for="destaque">
          <input
            id="destaque"
            name="destaque"
            type="checkbox"
            <%= evento.destaque ? 'checked' : '' %>
          >
          <span>Destacar este evento no carrossel</span>
        </label>

        <p>
          Marque esta opção somente se quiser exibir o evento no banner
          principal da página inicial.
        </p>
      </div>

      <div class="acoes-formulario">
        <button class="botao" type="submit">
          Salvar alterações
        </button>

        <a class="link-voltar" href="/eventos/<%= evento.id %>">
          Cancelar
        </a>
      </div>

    </form>
  </section>
</main>

<script>
  const arquivoEvento = document.getElementById('imagemArquivo');
  const campoImagemUpload = document.getElementById('imagemUpload');
  const previewImagem = document.getElementById('previewImagemEvento');
  if (arquivoEvento) arquivoEvento.addEventListener('change', () => {
    const arquivo = arquivoEvento.files[0];
    if (!arquivo) return;
    if (!arquivo.type.startsWith('image/') || arquivo.size > 4 * 1024 * 1024) {
      alert('Escolha uma imagem válida de até 4 MB.'); arquivoEvento.value = ''; return;
    }
    const leitor = new FileReader();
    leitor.onload = () => { campoImagemUpload.value = leitor.result; previewImagem.src = leitor.result; previewImagem.hidden = false; };
    leitor.readAsDataURL(arquivo);
  });

  const radiosVisibilidade = document.querySelectorAll('input[name="visibilidade"]');
  const textoAjudaVisibilidade = document.getElementById('texto-ajuda-visibilidade');
  const blocoDestaque = document.getElementById('bloco-destaque');
  const checkboxDestaque = document.getElementById('destaque');
  function atualizarVisibilidade() {
    const privado = document.querySelector('input[name="visibilidade"]:checked').value === 'privado';
    textoAjudaVisibilidade.textContent = privado
      ? 'Privado: só você e quem recebeu o convite poderão visualizar.'
      : 'Público: aparece na lista de eventos e pode ser destacado no carrossel.';
    blocoDestaque.hidden = privado;
    if (privado) checkboxDestaque.checked = false;
  }
  radiosVisibilidade.forEach(radio => radio.addEventListener('change', atualizarVisibilidade));
  atualizarVisibilidade();
</script>


<%- include('../partials/footer') %>
